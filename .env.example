# API origin only; do not append a path such as /api.
NUXT_PUBLIC_API_BASE=https://api.psray.net
# Absolute origin, no trailing slash — canonical / hreflang / OG URLs are built from it.
NUXT_PUBLIC_SITE_URL=https://psray.net
# Backend-generated OG images (origin only, without a path prefix).
NUXT_PUBLIC_CARD_BASE=https://api.psray.net
NUXT_PORT=3630
